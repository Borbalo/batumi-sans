# Python & OS
.venv/
__pycache__/
*.py[cod]
.DS_Store
*.DS_Store

# Heavy generated font builds & release archives (reproducible via scripts/)
dist/
releases/
proofs/
scratch/

# Duplicate staged Google Fonts TTFs (canonical 2-axis VFs are tracked under fonts/variable/)
google-fonts/*/*.ttf

# Local reference fonts, visual QA dumps & local Newsroom article drafts
/reference_fonts/
/analysis/*.png
/article/
/qa/varfont_audit/
/qa/build_audit/
/qa/condenser_audit/
/qa/*.png

